# Variables de entorno de EcoAula
# Copia este archivo a .env (desarrollo local) y reemplaza CADA valor <...> por uno propio.
# NUNCA agregues .env al control de versiones (Git). En producción las variables viven en
# /etc/ecoaula/ecoaula.env (chmod 600), ver docs/DESPLIEGUE.md.

# Clave AES-256 para cifrado de datos sensibles (ADR-09). Generar con:  openssl rand -base64 32
# En producción la aplicación no arranca sin esta clave.
ECOAULA_CLAVE_CIFRADO=<clave generada con openssl rand -base64 32>

# Base de datos MySQL (perfil dev con MySQL y docker-compose.yml)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=ecoaula_db
DB_USER=ecoaula_user
# Generar con:  openssl rand -base64 24
DB_PASSWORD=<contraseña del usuario de la aplicación>
DB_ROOT_PASSWORD=<contraseña de root de MySQL, distinta de la anterior>

# Servidor
SERVER_PORT=8080
