# Variables de entorno de EcoAula
# Copia este archivo a .env para desarrollo local
# NUNCA agregues .env al control de versiones (Git)

# Clave AES-256 para cifrado de datos sensibles (32 caracteres o base64)
ECOAULA_CLAVE_CIFRADO=ecoaula-clave-secreta-aes-256-ok!

# Base de datos MySQL (para perfil dev con MySQL o docker-compose)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecoaula_db
DB_USER=ecoaula_user
DB_PASSWORD=ecoaula_secret

# Servidor
SERVER_PORT=8080
